# Environment Variables for PV Test Lab Application
# Copy this file to .env and update with your actual values

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pvlab_db
DB_USER=pvlab_user
DB_PASSWORD=your-database-password

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# External Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@pvlab.com

# File Storage
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE=200
ALLOWED_EXTENSIONS=pdf,xlsx,csv,png,jpg,jpeg

# API Keys (if needed)
API_KEY=your-api-key-here
LLM_API_KEY=your-llm-api-key-here

# Security
SESSION_TIMEOUT=3600
ENABLE_HTTPS=False
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ISO 17025 Compliance
AUDIT_TRAIL_ENABLED=True
AUDIT_LOG_PATH=./logs/audit
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=90

# Feature Flags
ENABLE_LLM_INTEGRATION=True
ENABLE_ADVANCED_ANALYTICS=True
ENABLE_EXPORT_PDF=True
ENABLE_EXPORT_EXCEL=True
