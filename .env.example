# ============================================================================
# PV Test Report Automation - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control - it contains sensitive credentials

# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME="PV Test Report Automation"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=False

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite (Development)
DATABASE_URL="sqlite:///./pv_test.db"

# PostgreSQL (Production - Recommended)
# DATABASE_URL="postgresql://username:password@localhost:5432/pv_test_db"

# MySQL (Alternative)
# DATABASE_URL="mysql://username:password@localhost:3306/pv_test_db"

DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# Security Configuration
# ============================================================================
# IMPORTANT: Generate a strong secret key for production!
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-this-secret-key-in-production"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=True

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# ============================================================================
# LLM API Keys
# ============================================================================
# Anthropic Claude API (Recommended for technical document analysis)
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-3-opus-20240229"
CLAUDE_MAX_TOKENS=4096

# OpenAI API (Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_MAX_TOKENS=4096

# Google Gemini API (Alternative)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-pro"

# Default LLM Provider
DEFAULT_LLM_PROVIDER="claude"  # claude, openai, gemini

# LLM Request Configuration
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=2

# ============================================================================
# File Storage Configuration
# ============================================================================
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=".pdf,.xlsx,.xls,.csv,.jpg,.jpeg,.png,.txt,.docx"

REPORTS_DIR="./reports"
TEMP_DIR="./temp"
ARCHIVE_DIR="./archive"

# ============================================================================
# Report Generation Configuration
# ============================================================================
LATEX_COMPILER="pdflatex"  # pdflatex, xelatex, lualatex
LATEX_COMPILE_PASSES=2
REPORT_TEMPLATE_DIR="./templates"
REPORT_LOGO_PATH=""  # Optional: Path to company logo

# Laboratory/Company Information
COMPANY_NAME="PV Testing Laboratory"
COMPANY_ADDRESS=""
COMPANY_CONTACT=""
NABL_CERT_NUMBER=""
NABL_VALIDITY=""

# ============================================================================
# Email Configuration
# ============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=True
SMTP_USE_SSL=False

EMAIL_FROM="noreply@pvtesting.com"
EMAIL_FROM_NAME="PV Test Report System"

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="./logs/app.log"
LOG_ROTATION="1 day"
LOG_RETENTION="30 days"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ============================================================================
# API Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Testing Configuration
# ============================================================================
TEST_DATABASE_URL="sqlite:///./test_pv.db"
TEST_MODE=False

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_ENABLED=True
CACHE_BACKEND="redis"  # redis, memcached, inmemory
REDIS_URL="redis://localhost:6379/0"
CACHE_DEFAULT_TIMEOUT=300

# ============================================================================
# Celery/Background Task Configuration
# ============================================================================
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# Monitoring and Metrics
# ============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090

# Sentry (Error Tracking)
SENTRY_DSN=""

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_AI_EXTRACTION=True
ENABLE_AUTO_QA=True
ENABLE_BATCH_PROCESSING=True

# ============================================================================
# Production Deployment Notes
# ============================================================================
# For production deployment:
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=False
# 3. Generate and set a strong SECRET_KEY
# 4. Use PostgreSQL or MySQL instead of SQLite
# 5. Configure proper SMTP settings for email
# 6. Set up Redis for caching and Celery
# 7. Configure Sentry for error tracking
# 8. Set NABL certification details
# 9. Update CORS_ORIGINS with your frontend URLs
# 10. Store API keys securely (use vault/secrets manager)

# ============================================================================
# Security Best Practices
# ============================================================================
# - Never commit .env file to version control
# - Use environment-specific .env files (.env.dev, .env.prod)
# - Rotate API keys and secrets regularly
# - Use secrets management systems (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Enable rate limiting and monitoring in production
# - Use HTTPS for all API endpoints
# - Implement proper authentication and authorization
# - Regular security audits and dependency updates
