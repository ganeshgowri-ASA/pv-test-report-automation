# PV Test Report Automation - Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_USER=pv_admin
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://pv_admin:your_secure_password_here@postgres:5432/pv_test_automation

# Redis Cache
REDIS_URL=redis://redis:6379

# MinIO Object Storage
MINIO_USER=admin
MINIO_PASSWORD=your_secure_minio_password_here
MINIO_URL=minio:9000

# RabbitMQ Message Broker
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# LLM API Keys (Optional - for AI-powered features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Application Configuration
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here_min_32_chars

# ISO 17025 / NABL Configuration
ACCREDITATION_NUMBER=TC-XXXX
LAB_NAME=PV Testing Laboratory
LAB_ADDRESS=Your Lab Address Here
NABL_LOGO_PATH=/app/assets/nabl_logo.png
ILAC_LOGO_PATH=/app/assets/ilac_logo.png
COMPANY_LOGO_PATH=/app/assets/company_logo.png

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@pvtesting.com

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=xlsx,xls,docx,pdf,jpg,png,json,csv,xml,vsdx

# Report Generation
DEFAULT_REPORT_TEMPLATE=iso_17025_standard
ENABLE_LLM_NARRATIVES=true
DEFAULT_LLM_PROVIDER=claude
