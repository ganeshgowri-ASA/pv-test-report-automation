# PV Test Report Automation - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="PV Test Report Automation"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=production

# ============================================================================
# Claude API Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_ENDPOINT=https://api.anthropic.com/v1
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3
CLAUDE_TIMEOUT=120

# Rate Limiting
CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_DELAY=2.0
CLAUDE_RATE_LIMIT_REQUESTS=50

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_ALERT_THRESHOLD=100.0

# ============================================================================
# Database Configuration
# ============================================================================
# Example PostgreSQL connection string:
# DATABASE_URL=postgresql://username:password@localhost:5432/pv_reports
DATABASE_URL=postgresql://user:password@localhost/pv_reports
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log
AUDIT_LOG_PATH=logs/audit.log
LLM_LOG_PATH=logs/llm.log

# Audit Trail
ENABLE_AUDIT_TRAIL=true
AUDIT_LOG_LLM_PROMPTS=true
AUDIT_RETENTION_DAYS=365

# ============================================================================
# Security
# ============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_ENCRYPTION_ENABLED=true

# ============================================================================
# Report Generation
# ============================================================================
DEFAULT_REPORT_LANGUAGE=en

# ============================================================================
# File Storage
# ============================================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800
