# Environment Configuration Template

# Application Settings
APP_NAME=PV Test Report Automation
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Keys (Use Key Vault in production)
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_API_KEY=AIzaSyxxxxx

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pv_test_reports
REDIS_URL=redis://localhost:6379/0

# HashiCorp Vault (Session 37)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_NAMESPACE=pv-automation

# AWS Secrets Manager (Alternative to Vault)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
SECRETS_MANAGER_PREFIX=pv-automation/

# Security
SECRET_KEY=your-secret-key-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Export Settings
EXPORT_TEMP_DIR=/tmp/pv-exports
EXPORT_ARCHIVE_DIR=/var/pv-exports/archive
MAX_EXPORT_SIZE_MB=100

# LLM Orchestrator Settings
LLM_DEFAULT_MODEL=claude-3-5-sonnet-20241022
LLM_FALLBACK_ENABLED=True
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# Celery/Redis (Background Jobs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@pvautomation.com

# ISO 17025 Compliance
ENABLE_AUDIT_LOGGING=True
REQUIRE_DIGITAL_SIGNATURES=True
RETENTION_PERIOD_DAYS=2555
