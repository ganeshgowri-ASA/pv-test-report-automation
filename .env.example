# PV Test Report Automation - Environment Variables

# Lab Identification
LAB_ID=LAB-001
LAB_NAME=PV Testing Laboratory
LAB_LOCATION=Example City, Country

# Accreditation
ISO_17025_ACCREDITATION=NABL-TEST-001
NABL_ACCREDITATION=NABL-001
ILAC_ACCREDITATION=ILAC-001

# Database (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/pvtest
DATABASE_POOL_SIZE=10

# File Storage
DATA_STORAGE_PATH=/data/pv-test-results
THERMAL_IMAGE_PATH=/data/thermal-images
REPORT_OUTPUT_PATH=/data/reports

# Equipment Connection Timeouts (seconds)
EQUIPMENT_CONNECT_TIMEOUT=30
EQUIPMENT_READ_TIMEOUT=60

# Test Defaults
DEFAULT_OPERATOR=OP-UNKNOWN
DEFAULT_IRRADIANCE=1000.0
DEFAULT_TEST_TEMPERATURE=25.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/pv-test-automation.log

# Email Notifications (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=pvtest@example.com
SMTP_PASSWORD=your-password-here
NOTIFICATION_RECIPIENTS=lab-manager@example.com

# API Keys (for LLM integration - future use)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Security
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
