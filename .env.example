# PV Test Report Automation - Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Environment Settings
# ==========================================
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=True

# ==========================================
# JWT Configuration
# ==========================================
# IMPORTANT: Generate a strong secret key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# JWT Token Expiration (optional, defaults shown)
# JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT__API_KEY_TOKEN_EXPIRE_DAYS=365

# ==========================================
# API Vault Configuration
# ==========================================
# IMPORTANT: Generate a strong master key for production
# Use: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_VAULT_MASTER_KEY=your-vault-master-key-change-this-in-production

# API Vault Storage Path (optional)
# API_VAULT__STORAGE_PATH=/var/lib/pv-test-report/api_vault.json

# ==========================================
# Database Configuration (for future sessions)
# ==========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pv_test_report
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==========================================
# LLM API Keys
# ==========================================
# These will be stored in the encrypted API vault
# Add them through the API vault interface, not as environment variables

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT)
# OPENAI_API_KEY=sk-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# Cohere
# COHERE_API_KEY=...

# ==========================================
# CORS Configuration
# ==========================================
CORS_ENABLED=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# ==========================================
# Session Configuration
# ==========================================
SESSION__SESSION_TIMEOUT_MINUTES=60
SESSION__ABSOLUTE_SESSION_TIMEOUT_HOURS=12
SESSION__SECURE_COOKIES=True

# ==========================================
# Compliance Configuration (ISO 17025 & 21 CFR Part 11)
# ==========================================
COMPLIANCE__ENABLE_ELECTRONIC_SIGNATURES=True
COMPLIANCE__REQUIRE_SIGNATURE_REASON=True
COMPLIANCE__ENABLE_AUDIT_TRAIL=True
COMPLIANCE__AUDIT_RETENTION_DAYS=2555  # 7 years for compliance

# ==========================================
# RBAC Configuration
# ==========================================
RBAC__ALLOW_CUSTOM_ROLES=True
RBAC__DEFAULT_ROLE=viewer
RBAC__LOG_PERMISSION_CHECKS=True

# ==========================================
# Cryptography Configuration
# ==========================================
CRYPTO__BCRYPT_ROUNDS=12  # Range: 10-16 (higher = more secure but slower)
CRYPTO__PBKDF2_ITERATIONS=600000  # OWASP recommendation

# ==========================================
# Application Settings
# ==========================================
APP_NAME=PV Test Report Automation
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=True  # Set to False in production
