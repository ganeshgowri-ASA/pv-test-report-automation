# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=your-org-id-here  # Optional

# GPT Settings
GPT_DEFAULT_MODEL=gpt-4-turbo
GPT_DEFAULT_TEMPERATURE=0.7
GPT_DEFAULT_MAX_TOKENS=2000

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=90000

# Caching
ENABLE_CACHE=True
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Cost Tracking
ENABLE_COST_TRACKING=True
COST_ALERT_THRESHOLD=100.0

# Retry Logic
MAX_RETRIES=3
RETRY_DELAY=1.0
EXPONENTIAL_BACKOFF=True

# Compliance
DEFAULT_COMPLIANCE_STANDARD=IEC 61215

# Multi-language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,de,fr,zh,ja

# Logging
LOG_LEVEL=INFO
LOG_FILE=  # Optional log file path
