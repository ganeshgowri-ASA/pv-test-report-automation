# PV Test Automation System - Environment Configuration
# Copy this file to .env and configure your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pv_automation
DB_USER=postgres
DB_PASSWORD=changeme_secure_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# SECURITY CONFIGURATION
# ============================================
SECRET_KEY=generate_a_secure_random_key_here
REQUIRE_MFA=false
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:8000"]

# ============================================
# ACCREDITATION & COMPLIANCE
# ============================================
NABL_NUMBER=NABL-XXXXX
LAB_NAME=Your PV Testing Laboratory
LAB_ADDRESS=Your Laboratory Address
ENVIRONMENT=production

# ============================================
# LLM API KEYS
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# ============================================
# STORAGE PATHS
# ============================================
STORAGE_PATH=./data
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
TEMP_DIR=./data/temp
ARCHIVE_DIR=./data/archive

# ============================================
# APPLICATION PORTS
# ============================================
STREAMLIT_PORT=8501
API_PORT=8000

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@pvtestlab.com

# ============================================
# MONITORING (Optional)
# ============================================
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
