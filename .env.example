# PV Test Report Automation - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://pvtest_user:your_password_here@localhost:5432/pvtest
DB_PASSWORD=your_secure_database_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Security
SECRET_KEY=your_secret_key_at_least_32_characters_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email Configuration (Optional - for SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourlabname.com

# SMS Configuration (Optional - for Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=xlsx,xls,docx,doc,pdf,png,jpg,jpeg,tiff

# Report Generation
DEFAULT_REPORT_FORMAT=pdf
LATEX_COMPILER=pdflatex

# Laboratory Information
LAB_NAME=Your Laboratory Name
LAB_ADDRESS=Your Laboratory Address
LAB_ACCREDITATION=NABL-123456
LAB_LOGO_PATH=config/templates/lab_logo.png

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_SMS_NOTIFICATIONS=False

# Backup Settings
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Performance
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKERS=4
