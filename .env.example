# Environment Variables for PV Test Report Automation
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id  # Optional

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Azure OpenAI Configuration (if using Azure)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Application Settings
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_DIR=.cache/llm_responses

# Security Settings
API_KEY_ROTATION_DAYS=90
MAX_REQUEST_TIMEOUT=60

# Cost Management
DAILY_COST_LIMIT_USD=50
MONTHLY_COST_LIMIT_USD=1000

# NOTE: Never commit the actual .env file with real API keys to version control!
# The .env file is already in .gitignore
