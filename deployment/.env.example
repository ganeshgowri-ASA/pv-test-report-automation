# PV Test Report Automation - Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=PV Test Report Automation
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://pvtest:pvtest123@localhost:5432/pvtest_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# File Storage
STORAGE_TYPE=local  # Options: local, s3, azure
STORAGE_PATH=/data/uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=.xlsx,.pdf,.jpg,.png,.docx

# API Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@pvtest.example.com

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# Report Generation
REPORT_TIMEOUT=300
MAX_CONCURRENT_REPORTS=5
PDF_DPI=300

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# AWS (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=pvtest-uploads

# Azure (if using Azure Storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=pvtest-uploads
